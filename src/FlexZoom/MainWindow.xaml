<Window x:Class="FlexZoom.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlexZoom"
        Title="Flex Zoom" Width="970" Height="860" MinWidth="800" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#10141F" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" Icon="Assets/FlexZoom.ico">
  <Grid Margin="30,24,30,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentSurface}" Margin="0,0,12,0"><TextBlock Text="&#xE71E;" FontFamily="Segoe Fluent Icons" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" /></Border><TextBlock Text="Flex Zoom" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Background="#1E2535" CornerRadius="20" Padding="14,8" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#8A95AE" Width="7" Height="7" Margin="0,0,8,0" /><TextBlock x:Name="StatusLabel" Text="Lens off" FontSize="12" /></StackPanel></Border>
    </Grid>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid><TextBlock Text="Magnification" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="ZoomLabel" Text="2.5×" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
              <Slider x:Name="ZoomSlider" Minimum="1.25" Maximum="8" TickFrequency="0.25" IsSnapToTickEnabled="True" SmallChange="0.25" LargeChange="1" ValueChanged="SettingsChanged" Margin="0,12,0,0" AutomationProperties.Name="Magnification" />
              <Grid Margin="0,0,0,22"><TextBlock Text="1.25×" Style="{StaticResource Caption}" /><TextBlock Text="8×" Style="{StaticResource Caption}" HorizontalAlignment="Right" /></Grid>
              <TextBlock Text="Lens shape" FontWeight="SemiBold" Margin="0,0,0,12" />
              <UniformGrid Columns="3" Margin="0,0,-8,22">
                <RadioButton x:Name="CircleButton" GroupName="Shape" Style="{StaticResource ShapeButton}" Checked="SettingsChanged" AutomationProperties.Name="Circle"><StackPanel><Ellipse Width="23" Height="23" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Margin="0,0,0,9" /><TextBlock Text="Circle" HorizontalAlignment="Center" FontSize="12" /></StackPanel></RadioButton>
                <RadioButton x:Name="SquareButton" GroupName="Shape" Style="{StaticResource ShapeButton}" Checked="SettingsChanged" AutomationProperties.Name="Square"><StackPanel><Rectangle Width="23" Height="23" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Margin="0,0,0,9" /><TextBlock Text="Square" HorizontalAlignment="Center" FontSize="12" /></StackPanel></RadioButton>
                <RadioButton x:Name="RectangleButton" GroupName="Shape" Style="{StaticResource ShapeButton}" Checked="SettingsChanged" AutomationProperties.Name="Rectangle"><StackPanel><Rectangle Width="30" Height="23" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Margin="0,0,0,9" /><TextBlock Text="Rectangle" HorizontalAlignment="Center" FontSize="12" /></StackPanel></RadioButton>
              </UniformGrid>
              <Grid><TextBlock x:Name="SizeCaption" Text="Diameter" FontWeight="SemiBold" /><TextBlock x:Name="WidthLabel" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" /></Grid>
              <Slider x:Name="WidthSlider" Minimum="160" Maximum="720" TickFrequency="20" IsSnapToTickEnabled="True" SmallChange="20" ValueChanged="SettingsChanged" Margin="0,10,0,5" AutomationProperties.Name="Lens width or diameter" />
              <StackPanel x:Name="HeightPanel" Visibility="Collapsed" Margin="0,10,0,0"><Grid><TextBlock Text="Height" FontWeight="SemiBold" /><TextBlock x:Name="HeightLabel" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" /></Grid><Slider x:Name="HeightSlider" Minimum="140" Maximum="600" TickFrequency="20" IsSnapToTickEnabled="True" SmallChange="20" ValueChanged="SettingsChanged" Margin="0,10,0,0" AutomationProperties.Name="Lens height" /></StackPanel>
              <TextBlock Text="Size scales with your display settings." Style="{StaticResource Caption}" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="App preferences" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
              <TextBlock Text="Accent color" FontWeight="SemiBold" Margin="0,0,0,10" />
              <WrapPanel Margin="0,0,0,14">
                <RadioButton x:Name="PurpleAccent" GroupName="AccentColor" Tag="Purple" Style="{StaticResource ShapeButton}" Checked="AccentChanged" Margin="0,0,0,8" AutomationProperties.Name="Purple accent"><StackPanel Orientation="Horizontal"><Ellipse Fill="#A8A0FF" Width="12" Height="12" Margin="0,0,7,0" /><TextBlock Text="Purple" FontSize="12" /></StackPanel></RadioButton>
                <RadioButton x:Name="BlueAccent" GroupName="AccentColor" Tag="Blue" Style="{StaticResource ShapeButton}" Checked="AccentChanged" Margin="0,0,0,8" AutomationProperties.Name="Blue accent"><StackPanel Orientation="Horizontal"><Ellipse Fill="#83BEFF" Width="12" Height="12" Margin="0,0,7,0" /><TextBlock Text="Blue" FontSize="12" /></StackPanel></RadioButton>
                <RadioButton x:Name="TealAccent" GroupName="AccentColor" Tag="Teal" Style="{StaticResource ShapeButton}" Checked="AccentChanged" Margin="0,0,0,8" AutomationProperties.Name="Teal accent"><StackPanel Orientation="Horizontal"><Ellipse Fill="#69D9BF" Width="12" Height="12" Margin="0,0,7,0" /><TextBlock Text="Teal" FontSize="12" /></StackPanel></RadioButton>
                <RadioButton x:Name="RoseAccent" GroupName="AccentColor" Tag="Rose" Style="{StaticResource ShapeButton}" Checked="AccentChanged" Margin="0,0,0,8" AutomationProperties.Name="Rose accent"><StackPanel Orientation="Horizontal"><Ellipse Fill="#F69DBB" Width="12" Height="12" Margin="0,0,7,0" /><TextBlock Text="Rose" FontSize="12" /></StackPanel></RadioButton>
                <RadioButton x:Name="AmberAccent" GroupName="AccentColor" Tag="Amber" Style="{StaticResource ShapeButton}" Checked="AccentChanged" Margin="0,0,0,8" AutomationProperties.Name="Amber accent"><StackPanel Orientation="Horizontal"><Ellipse Fill="#F1C475" Width="12" Height="12" Margin="0,0,7,0" /><TextBlock Text="Amber" FontSize="12" /></StackPanel></RadioButton>
              </WrapPanel>
              <CheckBox x:Name="InvertCheck" Content="Invert lens colors" Checked="SettingsChanged" Unchecked="SettingsChanged" />
              <CheckBox x:Name="CloseToTrayCheck" Content="Close button hides to tray" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,18,0,0" />
              <TextBlock Text="When off, Close quits the app and turns off the lens." Style="{StaticResource Caption}" Margin="28,5,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <StackPanel><Grid Margin="20,18,20,0"><TextBlock Text="PREVIEW" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" /><TextBlock Text="Illustration" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" /></Grid><local:LensPreview x:Name="Preview" Height="135" Margin="10,0" /></StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16">
            <StackPanel>
              <TextBlock Text="Global shortcuts" FontSize="17" FontWeight="SemiBold" />
              <CheckBox x:Name="HotkeyEnabledCheck" Content="Enable toggle shortcut" Checked="HotkeyEnabledChanged" Unchecked="HotkeyEnabledChanged" Margin="0,14,0,10" />
              <Button x:Name="HotkeyButton" Tag="Toggle" Content="Ctrl + Alt + Z" Click="RecordHotkey" PreviewKeyDown="CaptureHotkey" LostKeyboardFocus="EndRecording" FontSize="15" FontWeight="SemiBold" Padding="12,10" HorizontalContentAlignment="Center" AutomationProperties.Name="Change toggle hotkey" />
              <TextBlock x:Name="HotkeyHint" Text="Click to record a different shortcut." Style="{StaticResource Caption}" Margin="0,9,0,0" />
              <CheckBox x:Name="ZoomHotkeyEnabledCheck" Content="Enable zoom shortcuts" Checked="HotkeyEnabledChanged" Unchecked="HotkeyEnabledChanged" Margin="0,18,0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Zoom in" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="ZoomInHotkeyButton" Grid.Column="1" Tag="ZoomIn" Content="Ctrl + Alt + Plus" Click="RecordHotkey" PreviewKeyDown="CaptureHotkey" LostKeyboardFocus="EndRecording" Padding="8,10" HorizontalContentAlignment="Center" AutomationProperties.Name="Change zoom in hotkey" />
              </Grid>
              <TextBlock x:Name="ZoomInHotkeyHint" Style="{StaticResource Caption}" Margin="0,6,0,10" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Zoom out" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="ZoomOutHotkeyButton" Grid.Column="1" Tag="ZoomOut" Content="Ctrl + Alt + Minus" Click="RecordHotkey" PreviewKeyDown="CaptureHotkey" LostKeyboardFocus="EndRecording" Padding="8,10" HorizontalContentAlignment="Center" AutomationProperties.Name="Change zoom out hotkey" />
              </Grid>
              <TextBlock x:Name="ZoomOutHotkeyHint" Style="{StaticResource Caption}" Margin="0,6,0,0" />
              <TextBlock Text="Changes zoom by 0.25× per press." Style="{StaticResource Caption}" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16">
            <StackPanel>
              <TextBlock Text="Startup" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
              <CheckBox x:Name="WindowsStartupCheck" Margin="0,0,0,14" Content="Launch when I sign in to Windows" Checked="WindowsStartupChanged" Unchecked="WindowsStartupChanged" />
              <CheckBox x:Name="TrayCheck" Margin="0,0,0,14" Content="Start in the system tray" Checked="SettingsChanged" Unchecked="SettingsChanged" />
              <CheckBox x:Name="StartupLensCheck" Content="Turn the lens on at startup" Checked="SettingsChanged" Unchecked="SettingsChanged" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBlock x:Name="Notice" Grid.Row="0" Visibility="Collapsed" Foreground="#F5C88F" TextWrapping="Wrap" Margin="0,0,0,12" />
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="SaveLabel" Text="Preferences saved automatically" FontSize="12" Foreground="{StaticResource Muted}" /><Button x:Name="ResetDefaultsButton" Content="Reset defaults" Click="ResetDefaults" HorizontalAlignment="Left" Padding="0,3" Background="Transparent" BorderThickness="0" FontSize="12" Foreground="{DynamicResource Accent}" /></StackPanel>
        <Button Grid.Column="1" Content="Hide to tray" Click="HideToTray" Margin="12,0" VerticalAlignment="Center" />
        <Button x:Name="ToggleButton" Grid.Column="2" Content="Turn lens on" Click="ToggleLens" Background="{DynamicResource Accent}" Foreground="#141126" FontWeight="SemiBold" BorderThickness="0" MinWidth="144" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Grid>
</Window>
