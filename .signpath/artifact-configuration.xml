<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <!-- upload-artifact wraps this one project-owned EXE in a ZIP. -->
  <zip-file>
    <pe-file path="FlexZoom.exe" product-name="Flex Zoom" product-version="${version}" original-filename="FlexZoom.dll">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
